<NotepadPlus version="2">

  <Languages>
  
    <Language name="Unturned Data File" ext="dat asset vdf tool udat udatproj" commentLine="/" commentStart="" commentEnd="">

      <Keywords name="keywords">true false this</Keywords>
      <Keywords name="props">Asset Metadata GUID ID Type</Keywords>
      
    </Language>
    
